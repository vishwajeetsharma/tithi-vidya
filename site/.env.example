# Copy to .env (or .env.local) for local testing, and add the same names in
# Vercel > Project > Settings > Environment Variables. Never commit real values.

# Brevo > SMTP & API > API keys. Only the server function reads it.
BREVO_API_KEY=

# Brevo > Contacts > Lists: the ID number of the newsletter list.
BREVO_LIST_ID=

# Optional. The ID of a Brevo double opt-in template. When set, people get a
# "please confirm" email first and land on /subscribed after clicking it.
BREVO_DOI_TEMPLATE_ID=

# The password for /backstage, the private page that previews scheduled posts.
# 12 or more characters. Without it, /backstage stays locked.
ADMIN_PASSWORD=
